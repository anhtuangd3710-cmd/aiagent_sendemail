# Email AI Agent - Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# AI PROVIDER SELECTION
# Set to "azure" or "gemini"
# ===========================================
AI_PROVIDER=gemini

# ===========================================
# AZURE OPENAI CONFIGURATION
# (Required only if AI_PROVIDER=azure)
# ===========================================
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# ===========================================
# GOOGLE GEMINI CONFIGURATION
# (Required only if AI_PROVIDER=gemini)
# Get your API key at: https://makersuite.google.com/app/apikey
# ===========================================
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash
# Available models: gemini-1.5-flash (fast), gemini-1.5-pro (better quality), gemini-pro

# ===========================================
# EMAIL CONFIGURATION (Using Gmail as example)
# ===========================================
# For Gmail, you need to:
# 1. Enable 2-Factor Authentication
# 2. Generate an App Password at https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# Sender (Person A) Email Configuration
SENDER_EMAIL=your-email@gmail.com
SENDER_PASSWORD=your-app-password-here

# ===========================================
# MONITORING CONFIGURATION
# ===========================================
CHECK_INTERVAL=10
REALTIME_MODE=true

# ===========================================
# DATABASE
# ===========================================
DATABASE_PATH=email_tracking.db
