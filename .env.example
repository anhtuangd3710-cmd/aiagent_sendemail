# Email AI Agent - Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# AI PROVIDER SELECTION
# Set to "azure" or "gemini"
# ===========================================
AI_PROVIDER=gemini

# ===========================================
# AZURE OPENAI CONFIGURATION
# (Required only if AI_PROVIDER=azure)
# ===========================================
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# ===========================================
# GOOGLE GEMINI CONFIGURATION
# (Required only if AI_PROVIDER=gemini)
# Get your API key at: https://makersuite.google.com/app/apikey
# ===========================================
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash
# Available models: gemini-1.5-flash (fast), gemini-1.5-pro (better quality), gemini-pro

# ===========================================
# EMAIL CONFIGURATION
# ===========================================
# Supported providers: Gmail, Outlook, Yahoo, custom SMTP
#
# ⚠️ IMPORTANT: You need an App Password, NOT your regular password!
#
# 📧 GMAIL - Get App Password:
#    1. Go to https://myaccount.google.com/security
#    2. Enable 2-Factor Authentication (if not already)
#    3. Go to https://myaccount.google.com/apppasswords
#    4. Select "Mail" and your device, click "Generate"
#    5. Copy the 16-character password (remove spaces)
#
# 📧 OUTLOOK/HOTMAIL - Get App Password:
#    1. Go to https://account.microsoft.com/security
#    2. Enable Two-step verification
#    3. Go to https://account.microsoft.com/security/passkeys
#    4. Click "Create a new app password"
#    5. Copy the generated password
#
# 📧 YAHOO - Get App Password:
#    1. Go to https://login.yahoo.com/account/security
#    2. Enable Two-step verification
#    3. Click "Generate app password"
#    4. Select "Other App", enter name, click "Generate"
#    5. Copy the generated password
#
# ===========================================

# Gmail settings (default)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# Outlook settings (uncomment if using Outlook)
# EMAIL_HOST=smtp.office365.com
# EMAIL_PORT=587
# IMAP_HOST=outlook.office365.com
# IMAP_PORT=993

# Yahoo settings (uncomment if using Yahoo)
# EMAIL_HOST=smtp.mail.yahoo.com
# EMAIL_PORT=587
# IMAP_HOST=imap.mail.yahoo.com
# IMAP_PORT=993

# Sender Email Configuration
SENDER_EMAIL=your-email@gmail.com
SENDER_PASSWORD=your-16-character-app-password

# ===========================================
# MONITORING CONFIGURATION
# ===========================================
# Check interval in seconds (how often to check for new emails)
CHECK_INTERVAL=10

# Realtime mode uses WebSocket for instant updates
REALTIME_MODE=true

# Auto-start monitoring when app starts (no user action needed)
AUTO_START_MONITOR=true

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# Database type: "sqlite" for development, "postgres" for production
DATABASE_TYPE=sqlite

# SQLite (default for development)
DATABASE_PATH=email_tracking.db

# ===========================================
# PostgreSQL / Neon Database (for production/Vercel)
# ===========================================
# 
# 📌 CÁCH LẤY DATABASE_URL TỪ NEON:
#
# 1. Truy cập https://console.neon.tech
# 2. Đăng ký/Đăng nhập tài khoản
# 3. Tạo project mới (hoặc chọn project có sẵn)
# 4. Vào Dashboard → Connection Details
# 5. Chọn "Connection string" (Pooled connection recommended)
# 6. Copy connection string có dạng:
#    postgresql://user:password@ep-xxx-yyy.region.aws.neon.tech/neondb?sslmode=require
#
# 📌 CẤU HÌNH TRÊN VERCEL:
#
# 1. Vào Vercel Dashboard → Project → Settings → Environment Variables
# 2. Thêm các biến sau:
#    - DATABASE_URL = (connection string từ Neon)
#    - AI_PROVIDER = gemini
#    - GEMINI_API_KEY = (API key từ Google)
#    - SENDER_EMAIL = (email của bạn)
#    - SENDER_PASSWORD = (App Password)
#    - SECRET_KEY = (random string dài)
#
# ===========================================

# Option 1: Use DATABASE_URL (recommended for Neon Database / Vercel)
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Option 2: Use individual parameters (standard PostgreSQL)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=email_agent
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your-password-here
# POSTGRES_SSLMODE=prefer

# ===========================================
# SECURITY (change in production!)
# ===========================================
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# ===========================================
# FIREBASE AUTHENTICATION (Optional)
# ===========================================
# 
# Firebase Authentication cho phép:
# - Đăng nhập bằng Email/Password với xác thực email
# - Đăng nhập bằng Google
# - Quên mật khẩu
#
# 📌 CÁCH LẤY FIREBASE CONFIG:
#
# 1. Truy cập https://console.firebase.google.com
# 2. Tạo project mới hoặc chọn project có sẵn
# 3. Vào Project Settings > General > Your apps > Add app (Web)
# 4. Copy các giá trị config:
#
FIREBASE_API_KEY=your-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789
FIREBASE_APP_ID=1:123456789:web:abc123

# 📌 FIREBASE ADMIN SDK (cho backend verification):
#
# 1. Firebase Console > Project Settings > Service Accounts
# 2. Click "Generate new private key"
# 3. Download JSON file và lấy các giá trị:
#
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...your key...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=123456789
FIREBASE_CLIENT_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxx%40your-project.iam.gserviceaccount.com

# Hoặc dùng file JSON (đặt file trong thư mục config/):
# FIREBASE_ADMIN_CREDENTIALS=config/firebase-adminsdk.json

# 📌 BẬT AUTHENTICATION TRONG FIREBASE:
#
# 1. Firebase Console > Authentication > Sign-in method
# 2. Enable "Email/Password" provider
# 3. Enable "Google" provider (optional)
# 4. Trong Settings tab:
#    - Authorized domains: thêm domain của bạn (localhost, vercel.app, etc.)
